<?xml version="1.0" encoding="utf-8"?>
<!-- Widget ArusKu: sisa uang + tombol catat cepat (hanya view yang didukung widget) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/w_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sisa uang"
                android:textColor="#FF9FAAA5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_sisa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Rp0"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_terpakai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Terpakai bulan ini Rp0"
                android:textColor="#FF9FAAA5"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ArusKu"
            android:textColor="#FF3DDC97"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_ketik"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1.3"
            android:background="@drawable/widget_btn_primary"
            android:gravity="center"
            android:maxLines="1"
            android:text="+ Ketik"
            android:textColor="#FF00281A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_parkir"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:maxLines="1"
            android:text="Parkir"
            android:textColor="#FFE8EDEA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_bensin"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:maxLines="1"
            android:text="Bensin"
            android:textColor="#FFE8EDEA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_makan"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:maxLines="1"
            android:text="Makan"
            android:textColor="#FFE8EDEA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_kopi"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:maxLines="1"
            android:text="Kopi"
            android:textColor="#FFE8EDEA"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
